{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Only Todo",
  "version": "0.1.0",
  "identifier": "com.only-todo.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1432",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Only Todo",
        "width": 960,
        "height": 720,
        "minWidth": 880,
        "minHeight": 560
      },
      {
        "label": "float-chrome",
        "title": "Only Todo Chrome",
        "width": 64,
        "height": 64,
        "decorations": false,
        "transparent": true,
        "shadow": false,
        "resizable": false,
        "alwaysOnTop": true,
        "visible": false,
        "focus": false,
        "skipTaskbar": true
      },
      {
        "label": "float-body",
        "title": "Only Todo Body",
        "width": 320,
        "height": 480,
        "decorations": false,
        "transparent": true,
        "shadow": false,
        "alwaysOnTop": true,
        "visible": false,
        "focus": false,
        "skipTaskbar": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' asset: http://asset.localhost blob: data:; font-src 'self'; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
